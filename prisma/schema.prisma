generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  CASH_ON_DELIVERY
}

model Admin {
  email     String   @id
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin")
}

model User {
  email          String           @id
  name           String
  password       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  sessions       Session[]

  orders         Order[]
  cart           Cart?
  shippingAddrs  ShippingAddress[]
  searchHistory  SearchHistory[]
  productViews   ProductView[]
  testimonials Testimonial[]

  @@map("user")
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userEmail    String
  expires      DateTime
  user         User      @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model ShippingAddress {
  id        Int     @id @default(autoincrement())
  userEmail String
  address   String
  city      String
  state     String
  country   String
  pinCode   String
  user      User    @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("shipping_address")
}

model SearchHistory {
  id         Int      @id @default(autoincrement())
  userEmail  String
  query      String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("search_history")
}

model Product {
  id          Int           @id @default(autoincrement())
  title       String
  tags        String[]
  description String
  price       Decimal
  inStock     Int
  category    String
  materialId  Int
  patternId   Int
  themeId     Int
  material    Material      @relation(fields: [materialId], references: [id])
  pattern     Pattern       @relation(fields: [patternId], references: [id])
  theme       Theme         @relation(fields: [themeId], references: [id])
  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  productViews ProductView[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  testimonials Testimonial[]

  @@map("product")
}

model Material {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("material")
}

model Pattern {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("pattern")
}

model Theme {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("theme")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_image")
}

model ProductView {
  id         Int      @id @default(autoincrement())
  userEmail  String
  productId  Int
  frequency  Int      @default(1)
  lastViewed DateTime @default(now())
  user       User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userEmail, productId])
  @@map("product_view")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userEmail String     @unique
  user      User       @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  cartItems CartItem[]

  @@map("cart")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id         Int         @id @default(autoincrement())
  userEmail  String
  total      Decimal
  status     OrderStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  items      OrderItem[]
  payment    Payment?

  @@map("order")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_item")
}

model Payment {
  id        Int             @id @default(autoincrement())
  orderId   Int             @unique
  amount    Decimal
  provider  PaymentProvider
  status    PaymentStatus   @default(PENDING)
  createdAt DateTime        @default(now())
  order     Order           @relation(fields: [orderId], references: [id])

  @@map("payment_details")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  userEmail  String
  productId Int
  review    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("testimonial")
}